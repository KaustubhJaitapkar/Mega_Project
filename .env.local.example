# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hackmate"

# NextAuth — must match the URL users use in the browser (scheme + host + port).
# If you open the app as http://10.0.0.5:3000, set that here (not only localhost).
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-chars-long"

# GitHub OAuth
GITHUB_ID="your-github-oauth-id"
GITHUB_SECRET="your-github-oauth-secret"

# Google OAuth — in Google Cloud Console → APIs & Services → Credentials → your OAuth client:
# Under "Authorized redirect URIs", add every base URL you use, each with:
#   {that exact origin}/api/auth/callback/google
# Example: http://localhost:3000/api/auth/callback/google
#          http://10.0.0.5:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@hackmate.com"

# Redis (optional for session store)
REDIS_URL="redis://localhost:6379"

# Application
APP_NAME="Hackmate"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Socket.io
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
